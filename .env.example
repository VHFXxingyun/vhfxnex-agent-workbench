# DeepSeek API key. The app reads this only from the project .env.local file.
# Leave empty to use the visibly labeled demonstration mode.
DEEPSEEK_API_KEY=

# Use at least 32 random bytes for signed login sessions in production.
SESSION_SECRET=

# This email becomes the admin account when registered.
ADMIN_EMAIL=

# Optional trusted reverse-proxy hops used to identify the client for rate limits.
# Unset defaults to 1 hop in development and 0 (ignore forwarded headers) in production.
# Set only when every hop is trusted and forwards X-Forwarded-For correctly.
# NEXORA_TRUSTED_PROXY_HOPS=1

# Optional OpenTelemetry collector. The app runs normally when this is unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=vhfxnex-goalflow
